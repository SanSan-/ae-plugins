<?xml version='1.0' encoding='UTF-8'?>
<ExtensionManifest
        ExtensionBundleId="ru.sansan.chatsubs"
        ExtensionBundleVersion="1.0.0"
        Version="7.0">

    <ExtensionList>
        <Extension Id="ru.sansan.chatsubs.panel" Version="1.0.0"/>
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <!-- AEFT = After Effects. Диапазон версий включает 25.x -->
            <Host Name="AEFT" Version="[13.6,25.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <!-- Рекомендуется CSXS 7.0: это безопасно и в новых версиях CEP, иначе бывают ошибки с 8.0+ :contentReference[oaicite:4]{index=4} -->
            <RequiredRuntime Name="CSXS" Version="7.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="ru.sansan.chatsubs.panel">
            <DispatchInfo>
                <Resources>
                    <!-- Путь от корня расширения -->
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/ae-chat-subtitles.jsx</ScriptPath>
                    <CEFCommandLine/>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>AE Chat / Subtitles</Menu>
                    <Geometry>
                        <Size>
                            <Height>500</Height>
                            <Width>350</Width>
                        </Size>
                    </Geometry>
                    <Icons/>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
