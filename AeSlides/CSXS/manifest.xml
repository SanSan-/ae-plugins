<?xml version='1.0' encoding='UTF-8'?>
<ExtensionManifest
        ExtensionBundleId="ru.sansan.aeslides"
        ExtensionBundleVersion="1.0.0"
        Version="7.0">

    <ExtensionList>
        <Extension Id="ru.sansan.aeslides.panel" Version="1.0.0"/>
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <Host Name="AEFT" Version="[13.6,25.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="7.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="ru.sansan.aeslides.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/ae-slides.jsx</ScriptPath>
                    <CEFCommandLine/>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>AE Slides</Menu>
                    <Geometry>
                        <Size>
                            <Height>300</Height>
                            <Width>320</Width>
                        </Size>
                    </Geometry>
                    <Icons/>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
